<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SampleApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/Theme.ZeotapSample">

        <!-- stateAlwaysHidden: the screen has text fields, and on API 23 the one that takes focus
             at launch opened the soft keyboard over the buttons. Taps then landed on the IME window
             ("InputDispatcher: Permission denied: injecting event … to window InputMethod"), which a
             test cannot inject into, failing whichever test tapped a covered button first. A person
             opening the sample does not want the keyboard either. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".TcfStubActivity" android:exported="false" />
    </application>
</manifest>
